# Configure estas variáveis na aba "Environment" do Easypanel. NÃO comite dados reais!
# O servidor NÃO sobe se alguma estiver faltando.

# Token da URL do MCP: https://<dominio>/mcp?token=<MCP_TOKEN>
# Gerar com: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_TOKEN=SEU_TOKEN_SECRETO_AQUI

# Credenciais OAuth do Google Tag Manager
GTM_CLIENT_ID=seu_client_id_aqui.apps.googleusercontent.com
GTM_CLIENT_SECRET=seu_client_secret_aqui
GTM_REFRESH_TOKEN=seu_refresh_token_aqui

PORT=8000
